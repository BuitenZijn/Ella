# Copy to .env (git-ignored). Read by apps/web (next.config.ts) and
# apps/mobile (app.config.ts). `npx convex dev` in packages/backend writes its
# own packages/backend/.env.local.
CONVEX_DEPLOYMENT=dev:beloved-dove-562
CONVEX_URL=https://beloved-dove-562.convex.cloud

# Set on the Convex deployment (npx convex env set ...), not here:
#   JWT_PRIVATE_KEY, JWKS    node packages/backend/scripts/generateKeys.mjs
#   SITE_URL                 the web app's URL (http://localhost:3000 in dev)
#   AUTH_RESEND_KEY          Resend API key
#   EMAIL_FROM               e.g. Ella <noreply@buitenzijnvzw.be>

