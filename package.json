{
  "name": "ella",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --filter=@ella/web --filter=@ella/backend",
    "dev:all": "turbo run dev --filter=@ella/web --filter=@ella/backend --filter=@ella/mobile",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "build:web": "turbo run build --filter=@ella/web"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.19.4"
  },
  "version": "1.0.0"
}
